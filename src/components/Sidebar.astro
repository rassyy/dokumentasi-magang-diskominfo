---
const navItems = [
  { href: '/', label: 'Overview', icon: 'home' },
  { href: '/timeline', label: 'Timeline Magang', icon: 'calendar_today' },
  { href: '/dokumentasi', label: 'Dokumentasi Teknis', icon: 'menu_book' },
  { href: '/pdf-library', label: 'PDF Library', icon: 'folder_open' },
  { href: '/profil', label: 'Profil', icon: 'person' },
];

const currentPath = Astro.url.pathname;
---

<aside class="sidebar glass" id="sidebar">
  <div class="sidebar-header">
    <span class="sidebar-logo" style="background: linear-gradient(135deg, var(--accent), #004d99);">DM</span>
    <div>
      <h1 class="sidebar-title">Docs Magang</h1>
      <p class="sidebar-subtitle">Diskominfo Tuban</p>
    </div>
  </div>
  <nav class="sidebar-nav" id="sidebar-nav">
    <!-- frosted glass pill, slides between items -->
    <div class="nav-indicator" id="nav-indicator"></div>
    {
      navItems.map((item, i) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: currentPath === item.href }]}
          data-index={i}
        >
          <span class="nav-icon material-symbols-outlined">{item.icon}</span>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="sidebar-footer">
    <p>© {new Date().getFullYear()} Magang Aptika</p>
  </div>
</aside>

<script>
  const nav = document.getElementById('sidebar-nav');
  const indicator = document.getElementById('nav-indicator');
  if (nav && indicator) {
    const links = Array.from(nav.querySelectorAll('.nav-link'));
    const move = (link) => {
      indicator.style.top = link.offsetTop + 'px';
      indicator.style.left = link.offsetLeft + 'px';
      indicator.style.width = link.offsetWidth + 'px';
      indicator.style.height = link.offsetHeight + 'px';
      indicator.style.opacity = '1';
    };
    const syncActive = () => move(links.find((l) => l.classList.contains('active')) || links[0]);

    // position on load after layout settled
    requestAnimationFrame(() => requestAnimationFrame(syncActive));
    window.addEventListener('resize', syncActive);

    // slide to hovered item, revert to active on leave
    links.forEach((link) => {
      link.addEventListener('mouseenter', () => move(link));
      nav.addEventListener('mouseleave', syncActive);
    });
  }
</script>

<style>
  .sidebar-nav {
    position: relative;
    flex: 1;
  }
  .nav-indicator {
    position: absolute;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 4px 16px rgba(0, 30, 80, 0.06);
    border-radius: var(--radius-md);
    opacity: 0;
    z-index: 0;
    transition: top 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                left 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s;
  }
</style>