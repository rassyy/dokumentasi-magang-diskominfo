---
import { DOCUMENTS } from '../data/documents';
import { TOPICS } from '../data/topics';
import { WEEKS } from '../data/weeks';

const totalDocs = DOCUMENTS.length;
const totalTopics = TOPICS.length;
const totalWeeks = WEEKS.length;
const completedWeeks = WEEKS.filter((w) => w.status === 'completed').length;
const progress = Math.round((completedWeeks / totalWeeks) * 100);
const stats = [
  { value: String(totalWeeks), label: 'Minggu Magang' },
  { value: String(totalDocs), label: 'Dokumen PDF' },
  { value: String(totalTopics), label: 'Topik Teknis' },
  { value: `${progress}%`, label: 'Progress' },
];
---

<section class="hero">
  <div class="container hero-inner fade-in-up">
      <span class="hero-badge">UIN Malang · Diskominfo Tuban · Divisi Aptika</span>
      <div class="hero-title-row">
        <img src="/assets/img/diskominfo-logo.png" alt="Logo Diskominfo" class="hero-logo" />
        <h1 class="hero-title">Portal Dokumentasi Magang Diskominfo Tuban</h1>
      </div>
    <p class="hero-desc">
      Dokumentasi kegiatan magang, logbook mingguan, dan artefak teknis.
      dari jaringan, virtualisasi, hingga AI agent infrastructure.
    </p>
    <div class="hero-actions">
      <a href="/timeline" class="btn btn-primary">Lihat Timeline</a>
      <a href="/pdf-library" class="btn btn-ghost">Buka PDF Library</a>
    </div>
    <div class="hero-stats fade-in-up" style="transition-delay: 0.2s;">
      {
        stats.map((s) => (
          <div class="hero-stat card glass" style="padding: 16px 24px;">
            <strong class="counter" data-target={s.value}>0</strong>
            <span>{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

