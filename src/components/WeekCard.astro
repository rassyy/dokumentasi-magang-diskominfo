---
import type { Week, DocumentItem } from '../types';
interface Props { week: Week; documents: DocumentItem[]; delay?: number; }
const { week, documents, delay = 0 } = Astro.props;
const weekDocs = documents.filter((d) => week.documents.includes(d.id));
const catLabel: Record<string, string> = {
  networking: 'Networking',
  virtualization: 'Virtualization',
  cloud: 'Cloud & Security',
  'ai-agent': 'AI Agent',
  backup: 'Backup & Restore',
  monitoring: 'Monitoring',
};
---

<article class:list={['week-card', `status-${week.status}`, 'fade-in-up']} style={delay ? `transition-delay: ${delay}ms` : ''}>
  <div class="week-dot" style={week.status === 'completed' ? 'animation: pulse-ring 2s infinite;' : ''}></div>
  <div class="week-content card">
    <div class="week-head">
      <span class="week-badge">Minggu {week.number}</span>
      <span class:list={['status-badge', `status-${week.status}`]}>{week.status === 'completed' ? 'Selesai' : 'Planned'}</span>
    </div>
    <h3 class="week-title">{week.title}</h3>
    <p class="week-subtitle">{week.subtitle}</p>
    <p class="week-summary">{week.summary}</p>
    {week.categories.length > 0 && (
      <div class="week-cats">
        {week.categories.map((c) => <span class="cat-chip">{catLabel[c] ?? c}</span>)}
      </div>
    )}
    {week.activities.length > 0 && (
      <ul class="week-activities">
        {week.activities.map((a) => <li>{a.title}</li>)}
      </ul>
    )}
    {weekDocs.length > 0 && (
      <div class="week-docs">
        {weekDocs.map((d) => (
          <a href={d.file} target="_blank" rel="noopener" class="doc-link">
            📄 {d.title}
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 rgba(0, 117, 222, 0.4); }
    70% { box-shadow: 0 0 0 6px rgba(0, 117, 222, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 117, 222, 0); }
  }
</style>