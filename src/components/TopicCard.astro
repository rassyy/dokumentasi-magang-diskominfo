---
import type { Topic } from '../types';
interface Props { topic: Topic; delay?: number; }
const { topic, delay = 0 } = Astro.props;
---

<a href="/dokumentasi" class="topic-card card fade-in-up" style={delay ? `transition-delay: ${delay}ms` : ''}>
  <h3 class="topic-name">{topic.name}</h3>
  <p class="topic-desc">{topic.desc}</p>
  <span class="topic-count">{topic.docs.length} dokumen</span>
</a>